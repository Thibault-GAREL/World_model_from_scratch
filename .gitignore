# .gitignore template for a new AI/ML project of Thibault GAREL.
# THIS FILE IS THE SINGLE SOURCE. Copy it as .gitignore at the project root, never retype
# it from memory. SKILL.md only points here and carries the warnings that go with it.
# Principle: everything a run produces is versioned, only the raw data, the build
# artifacts and the Claude Code session files are excluded.

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
.venv
ENV/

# IDE (.vscode/settings.json is versioned on purpose, the project ships it)
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data (keep the directory structure, exclude the files themselves)
data/1-raw/*
data/2-processed/*
data/3-external/*
!data/**/.gitkeep

# Outputs and MLflow: NOTHING is excluded here.
# outputs/models/, outputs/results/, outputs/logs/ and mlruns/ are versioned on purpose,
# so a run stays readable and plottable from GitHub alone (RunLogger keeps the logs light).
# Only add an exclusion here if a file crosses GitHub's 100 MB limit, e.g.:
#   outputs/models/**/checkpoints/

# Environment
.env
.env.local

# Claude Code (session-scoped, never pushed)
# .claude/settings.json IS versioned on purpose: it carries the shared permissions.
# Only the deferred tasks (do-it-later) and the local overrides are excluded.
.claude/queued/
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
